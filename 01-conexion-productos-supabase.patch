+import { createClient } from '@/lib/supabase/client'
+
+export interface Product {
+  id: string
+  name: string
+  description: string | null
+  price: number
+  discount_price: number | null
+  image_url: string | null
+  badge_text: string | null
+  category_id: string | null
+  stock: number | null
+  rating: number | null
+  reviews_count: number | null
+  is_featured: boolean | null
+  is_active: boolean | null
+  created_at: string | null
+  updated_at: string | null
+}
+
+export interface ProductVariant {
+  id: string
+  product_id: string
+  variant_type: string
+  variant_value: string
+  stock: number | null
+  price_modifier: number | null
+}
+
+/**
+ * Trae productos activos para la home / listados.
+ * Usa el cliente de navegador porque las políticas RLS permiten
+ * lectura pública de productos con is_active = true.
+ */
+export async function getProducts(options?: { featuredOnly?: boolean; limit?: number }) {
+  const supabase = createClient()
+
+  let query = supabase
+    .from('products')
+    .select('*')
+    .eq('is_active', true)
+    .order('created_at', { ascending: false })
+
+  if (options?.featuredOnly) {
+    query = query.eq('is_featured', true)
+  }
+  if (options?.limit) {
+    query = query.limit(options.limit)
+  }
+
+  const { data, error } = await query
+
+  if (error) {
+    console.error('[getProducts] error consultando productos:', error.message)
+    return { products: [] as Product[], error: error.message }
+  }
+
+  return { products: (data ?? []) as Product[], error: null }
+}
+
+/**
+ * Trae un producto por id junto con sus variantes (talla, color, etc).
+ */
+export async function getProductById(id: string) {
+  const supabase = createClient()
+
+  const [{ data: product, error: productError }, { data: variants, error: variantsError }] =
+    await Promise.all([
+      supabase.from('products').select('*').eq('id', id).eq('is_active', true).single(),
+      supabase.from('product_variants').select('*').eq('product_id', id),
+    ])
+
+  if (productError) {
+    console.error('[getProductById] error consultando producto:', productError.message)
+    return { product: null, variants: [] as ProductVariant[], error: productError.message }
+  }
+
+  return {
+    product: product as Product,
+    variants: (variants ?? []) as ProductVariant[],
+    error: variantsError?.message ?? null,
+  }
+}
