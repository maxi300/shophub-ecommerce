+const FALLBACK_IMAGE = '/placeholder.svg'
+const PRODUCT_IMAGES_BUCKET = 'product-images'
+
+/**
+ * Resuelve la URL final de la imagen de un producto.
+ * - Si no hay imageUrl -> fallback local (placeholder.svg)
+ * - Si ya es una URL completa (http/https) -> se usa tal cual
+ * - Si es solo un path guardado dentro del bucket -> arma la URL pública de Supabase Storage
+ */
+export function getProductImageUrl(imageUrl?: string | null): string {
+  if (!imageUrl || imageUrl.trim() === '') {
+    return FALLBACK_IMAGE
+  }
+
+  if (imageUrl.startsWith('http://') || imageUrl.startsWith('https://')) {
+    return imageUrl
+  }
+
+  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL
+  if (!supabaseUrl) {
+    return FALLBACK_IMAGE
+  }
+
+  const cleanPath = imageUrl.replace(/^\/+/, '')
+  return `${supabaseUrl}/storage/v1/object/public/${PRODUCT_IMAGES_BUCKET}/${cleanPath}`
+}
+
+export { FALLBACK_IMAGE }
